# ===== EH Bot config =====
# Copy this file to ".env" and fill in your values.

# Required — Discord bot token (discord.com/developers/applications)
DISCORD_TOKEN=

# Optional — GoFile account token (empty = guest upload)
GOFILE_TOKEN=

# Optional — bot only works in these channels (comma-separated IDs).
# Empty = works everywhere. Get ID: right-click channel -> Copy Channel ID
# (needs Settings -> Advanced -> Developer Mode).
ALLOWED_CHANNEL_IDS=
